  "facets": [
    {"key": "gender", "name": "Gender", "type": "enum", "values": ["mens", "womens", "unisex"], "required": true, "description": "Target audience."},
    {"key": "use_case", "name": "Use Case", "type": "enum", "values": ["powerlifting", "weightlifting", "strongman", "bodybuilding", "general_fitness", "crossfit"], "description": "Primary athletic context."},
    {"key": "tier", "name": "Tier", "type": "enum", "values": ["pro", "premium", "core"], "description": "Internal product tier. Pro = top of line, Premium = signature, Core = entry."},
    {"key": "material", "name": "Material", "type": "enum_multi", "values": ["leather", "suede", "neoprene", "cotton", "polyester", "nylon", "technical_blend", "bamboo", "modal"], "description": "Primary fabric/material."},
    {"key": "thickness", "name": "Thickness", "type": "enum", "values": ["5mm", "7mm", "10mm", "13mm"], "description": "For belts and sleeves where mm thickness is a consumer-facing spec."},
    {"key": "closure", "name": "Closure", "type": "enum", "values": ["lever", "single_prong", "double_prong", "velcro", "zipper", "buckle"], "description": "Mechanical closure type. Most relevant on belts."},
    {"key": "certification", "name": "Certification", "type": "enum_multi", "values": ["ipf_approved", "uspa_approved", "usapl_approved", "wpc_approved"], "description": "Federation approval. Required for serious competitive lifters."},
    {"key": "season", "name": "Season", "type": "enum", "values": ["ss", "fw", "all_season", "core"], "description": "Drop season. Core = always-on assortment."},
    {"key": "launch_year", "name": "Launch Year", "type": "int", "description": "Year the style was first introduced."}
  ],
  "channels": [
    {"slug": "shopify", "name": "Shopify DTC", "type": "dtc", "url_root": "https://gymreapers.com", "notes": "Owned site. Source of truth for SKU master, pricing baseline, marketing messaging."},
    {"slug": "amazon_us", "name": "Amazon US", "type": "marketplace", "notes": "Browse Tree mapping required per class. Variation theme limited to color x size for apparel; size only for belts."},
    {"slug": "gnc", "name": "GNC", "type": "wholesale_retail", "notes": "Wholesale partner. Joins on UPC, not internal SKU. Pack/case quantities differ from DTC."}
  ],
  "channel_class_mapping_template": {
    "shopify": {"strategy": "passthrough", "fields": ["product_type=class.name", "tags=division+department+facets", "vendor=Gymreapers"]},
    "amazon_us": {"strategy": "lookup_table", "required": ["external_node_id", "external_node_path", "title_template", "required_attrs"]},
    "gnc": {"strategy": "lookup_table", "required": ["gnc_department", "gnc_class_code", "case_qty"]}
  }
